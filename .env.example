# Optional. Without these the game runs fully offline: local save file and
# same-device multiplayer between browser tabs.
#
# Both values are safe to expose to the browser: they ship in the client bundle
# by design, and Row Level Security is what protects the data. Use the key
# labelled "anon public" or "publishable" — never the "service_role" or "secret"
# one, which bypasses every policy in the schema.
#
# Copy this file to `.env` and fill it in. Do not rename it: `.env` is
# gitignored, but a rename makes git track the file, and once a file is tracked
# gitignore no longer applies to it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
