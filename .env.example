# Optional. Without these the game runs fully offline: local save file and
# same-device multiplayer between browser tabs.
#
# Both values are safe to expose to the browser — the anon key is public by
# design and Row Level Security is what protects the data. Never put the
# service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
